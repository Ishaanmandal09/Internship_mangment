const jwt = require('jsonwebtoken');

const authMiddleware = (req, res, next) => {
  const Enrollment = require('../models/Enrollment');

exports.verifyEnrollment = async (req, res, next) => {
  try {
    if (req.user.role === 'admin' || req.user.role === 'teacher') {
      return next();
    }

    // Find if the student is approved for the internship
    const internshipId = req.params.internshipId || req.body.internshipId;
    
    const enrollment = await Enrollment.findOne({
      student: req.user.id || req.user._id,
      status: 'approved'
    });

    if (!enrollment) {
      return res.status(403).json({ error: 'Access denied. You must be enrolled and approved in this internship to view resources.' });
    }

    next();
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

  const token = req.header('Authorization')?.replace('Bearer ', '');
  if (!token) return res.status(401).json({ error: 'No token, authorization denied' });

  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET);
    req.user = decoded;
    next();
  } catch (err) {
    res.status(401).json({ error: 'Token is not valid' });
  }
};

const authorize = (...roles) => {
  return (req, res, next) => {
    if (!roles.includes(req.user.role)) {
      return res.status(403).json({ error: 'Access denied: insufficient permissions' });
    }
    next();
  };
};

module.exports = { authMiddleware, authorize };